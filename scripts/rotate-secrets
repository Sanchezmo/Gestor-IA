#!/usr/bin/env python3
"""
Rotate Secrets CLI - Modular secret rotation for Gestor-IA.

Principio: UNA CREDENCIAL = UNA OPERACIÓN AISLADA

Cada subcomando maneja un tipo de credencial de forma independiente:
- preflight → backup → change → validate → (rollback si falla) → post-check

Uso:
    rotate-secrets cloudflare
    rotate-secrets telegram --instance development
    rotate-secrets webhook-secret --instance development
    rotate-secrets dolibarr-user-api-key --instance development --user-id 1
    rotate-secrets dolibarr-db-password --instance development
    rotate-secrets redis
    rotate-secrets internal-secrets

    rotate-secrets --list          # Listar operaciones disponibles
    rotate-secrets --help          # Ayuda general
    rotate-secrets <cmd> --help    # Ayuda específica
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

# Add project root to path for imports
sys.path.insert(0, str(Path(__file__).parent.parent))

from scripts.rotate.cloudflare import CloudflareRotation
from scripts.rotate.telegram import TelegramRotation
from scripts.rotate.webhook_secret import WebhookSecretRotation
from scripts.rotate.dolibarr_user_api_key import DolibarrUserApiKeyRotation
from scripts.rotate.dolibarr_db_password import DolibarrDbPasswordRotation
from scripts.rotate.redis import RedisRotation
from scripts.rotate.internal_secrets import InternalSecretsRotation


COMMANDS = {
    "cloudflare": {
        "class": CloudflareRotation,
        "help": "Rotate Cloudflare Tunnel Token",
        "args": [],
    },
    "telegram": {
        "class": TelegramRotation,
        "help": "Rotate Telegram Bot Token for an instance",
        "args": [
            (["--instance", "-i"], {"required": True, "help": "Instance ID (e.g., development)"}),
        ],
    },
    "webhook-secret": {
        "class": WebhookSecretRotation,
        "help": "Rotate Telegram Webhook Secret for an instance",
        "args": [
            (["--instance", "-i"], {"required": True, "help": "Instance ID (e.g., development)"}),
        ],
    },
    "dolibarr-user-api-key": {
        "class": DolibarrUserApiKeyRotation,
        "help": "Rotate Dolibarr User API Key for an instance",
        "args": [
            (["--instance", "-i"], {"required": True, "help": "Instance ID"}),
            (["--user-id", "-u"], {"type": int, "default": 1, "help": "Dolibarr user ID (default: 1)"}),
        ],
    },
    "dolibarr-db-password": {
        "class": DolibarrDbPasswordRotation,
        "help": "Rotate Dolibarr Database User Password",
        "args": [
            (["--instance", "-i"], {"required": True, "help": "Instance ID"}),
        ],
    },
    "redis": {
        "class": RedisRotation,
        "help": "Rotate Redis Password",
        "args": [],
    },
    "internal-secrets": {
        "class": InternalSecretsRotation,
        "help": "Rotate Internal Secrets (JWT, Fernet, Admin Token, Backup Key)",
        "args": [],
    },
}


def create_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="rotate-secrets",
        description="Modular secret rotation for Gestor-IA (UNA CREDENCIAL = UNA OPERACIÓN AISLADA)",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Ejemplos:
  rotate-secrets cloudflare
  rotate-secrets telegram -i development
  rotate-secrets webhook-secret -i development
  rotate-secrets dolibarr-user-api-key -i development -u 1
  rotate-secrets dolibarr-db-password -i development
  rotate-secrets redis
  rotate-secrets internal-secrets

  rotate-secrets telegram -i development --dry-run
  rotate-secrets cloudflare --verbose

Flujo de cada operación:
  1. PREFLIGHT - Verificar prerequisitos
  2. BACKUP    - Respaldar estado actual
  3. CHANGE    - Aplicar cambios
  4. VALIDATE  - Verificar que funciona
  5. ROLLBACK  - (si validate falla) Revertir
  6. POST-CHECK - Verificación final
""",
    )

    parser.add_argument(
        "--list", "-l",
        action="store_true",
        help="Listar operaciones disponibles"
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Simular sin hacer cambios reales"
    )
    parser.add_argument(
        "--verbose", "-v",
        action="store_true",
        help="Salida detallada"
    )

    subparsers = parser.add_subparsers(dest="command", metavar="COMANDO")

    for cmd_name, cmd_info in COMMANDS.items():
        cmd_parser = subparsers.add_parser(cmd_name, help=cmd_info["help"])
        for args_t, kwargs in cmd_info["args"]:
            cmd_parser.add_argument(*args_t, **kwargs)
        cmd_parser.add_argument("--dry-run", action="store_true", help="Simular sin cambios")
        cmd_parser.add_argument("--verbose", "-v", action="store_true", help="Salida detallada")

    return parser


def list_commands() -> None:
    print("Operaciones de rotación disponibles:\n")
    for name, info in COMMANDS.items():
        print(f"  {name:<30} {info['help']}")
    print("\nUso: rotate-secrets <comando> [opciones]")
    print("     rotate-secrets <comando> --help  # Ayuda específica")


def main() -> int:
    parser = create_parser()
    args = parser.parse_args()

    if args.list or not args.command:
        list_commands()
        return 0

    if args.command not in COMMANDS:
        parser.error(f"Comando desconocido: {args.command}")

    cmd_info = COMMANDS[args.command]
    cls = cmd_info["class"]

    # Prepare constructor args
    kwargs = {"dry_run": args.dry_run, "verbose": args.verbose}
    # Only pass instance_id if the command expects it (has instance_id in __init__ and --instance was provided)
    if "instance_id" in cls.__init__.__code__.co_varnames:
        if hasattr(args, "instance") and args.instance is not None:
            kwargs["instance_id"] = args.instance
    if "dolibarr_user_id" in cls.__init__.__code__.co_varnames:
        kwargs["dolibarr_user_id"] = getattr(args, "user_id", 1)

    try:
        rotation = cls(**kwargs)
        result = rotation.run()

        print(f"\n✅ {cmd_info['help']} completado exitosamente")
        if result.warnings:
            print("\n⚠️  Advertencias:")
            for w in result.warnings:
                print(f"  - {w}")

        return 0

    except KeyboardInterrupt:
        print("\n\n❌ Operación cancelada por el usuario")
        return 130
    except Exception as e:
        print(f"\n❌ Error: {e}")
        if args.verbose:
            import traceback
            traceback.print_exc()
        return 1


if __name__ == "__main__":
    sys.exit(main())