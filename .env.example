# =============================================================================
# GESTOR-IA - Variables de Entorno Globales (Infraestructura Compartida)
# =============================================================================
# Copiar a .env y completar con valores reales
# NUNCA commitear .env con secretos reales
# Los secretos por instancia van en instances/{instance_id}/instance.env
# =============================================================================

# =============================================================================
# ENTORNO GENERAL
# =============================================================================
GESTOR_IA_ENV=development          # development | staging | production
# PROJECT_ROOT se auto-detecta (Path.cwd()) - no configurar manualmente

# =============================================================================
# MARIADB (Servidor compartido - Múltiples DBs por instancia)
# =============================================================================
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_ROOT_PASSWORD=           # Generar: openssl rand -base64 32

# =============================================================================
# REDIS (Compartido - OPCIONAL para desarrollo, REQUERIDO en producción)
# Uso: Idempotencia Telegram webhook, rate limiting, cache.
# NOTA: Redis DB number (0-15) NO es frontera de seguridad real.
#       Para aislamiento real usar: namespace/prefix, ACL, o instancias separadas.
# =============================================================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=                  # Generar: openssl rand -base64 32
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# =============================================================================
# SEGURIDAD GLOBAL
# =============================================================================
JWT_SECRET_KEY=                  # Generar: openssl rand -base64 64
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=7

FERNET_KEY=                      # Generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# =============================================================================
# CORS (Environment-aware)
# =============================================================================
# Production: Comma-separated explicit allowlist (e.g., "https://app.empresa.com,https://api.empresa.com")
# Development: Uses defaults (localhost:3000, localhost:8000)
CORS_ALLOW_ORIGINS=

# =============================================================================
# RATE LIMITING GLOBAL
# =============================================================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# =============================================================================
# IDEMPOTENCIA GLOBAL
# =============================================================================
IDEMPOTENCY_TTL_HOURS=24

# =============================================================================
# IA COMPARTIDA (GPU/Ollama - Una instancia para todas las empresas)
# Modelo se configura por instancia en InstanceConfig.ai.ollama_model
# =============================================================================
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434

# =============================================================================
# CLOUDFLARE (Infraestructura compartida - Tunnel + DNS + Access)
# =============================================================================
CLOUDFLARE_API_TOKEN=            # Zone:Read, DNS:Edit, Access:Edit
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_TUNNEL_TOKEN=         # Para cloudflared systemd
CLOUDFLARE_TUNNEL_ID=

# =============================================================================
# APACHE (Proxy reverso local para Dolibarr por instancia)
# =============================================================================
APACHE_PORT=8080
APACHE_DOLIBARR_BASE_PORT=8081  # Cada instancia: base_port + offset

# =============================================================================
# BACKUPS
# =============================================================================
BACKUP_SCHEDULE="0 2 * * *"          # Diario 02:00
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_KEY=               # Generar: openssl rand -base64 32
BACKUP_LOCAL_PATH=/var/backups/gestor-ia

# =============================================================================
# MONITORIZACIÓN (Opcional)
# =============================================================================
PROMETHEUS_PORT=9090
METRICS_ENABLED=true

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json